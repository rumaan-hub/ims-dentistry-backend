generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String            @id @default(uuid())
  name      String
  image     String
  slug      String?           @unique
  parentId  String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  approved  Boolean           @default(true)
  parent    Category?         @relation("CategoryToSubcategories", fields: [parentId], references: [id])
  children  Category[]        @relation("CategoryToSubcategories")
  products  ProductCategory[]
}

model Reply {
  id       String  @id @default(uuid())
  reply    String
  userId   String  @unique
  reviewId String  @unique
  reviews  Reviews @relation(fields: [reviewId], references: [id])
  user     User    @relation(fields: [userId], references: [id])
}

model Reviews {
  id           String   @id @default(uuid())
  review       String
  rating       String
  userId       String
  productId    String
  images       String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sellerRating String
  reply        Reply?
  product      Product  @relation(fields: [productId], references: [id])
  user         User     @relation(fields: [userId], references: [id])
}

model Material {
  id       String    @id @default(uuid())
  name     String
  images   String?
  products Product[]
}

model Questions {
  id        String    @id @default(uuid())
  question  String
  userId    String
  productId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  answers   Answers[]
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Answers {
  id         String    @id @default(uuid())
  reply      String
  vendorId   String
  questionId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  questions  Questions @relation(fields: [questionId], references: [id])
  vendor     Vendors   @relation(fields: [vendorId], references: [id])
}

model Product {
  id                    String                 @id @default(uuid())
  title                 String
  descriptiveTitle      String
  totalSold             Int                    @default(0)
  totalReviews          Int                    @default(0)
  images                String[]
  description           String
  approved              Boolean
  totalSales            Int                    @default(0)
  quantity              Int?                   @default(0)
  featured              Boolean                @default(false)
  manufacturer          String?
  packaging             String?
  materialId            String?
  type                  String?
  vasoconstrictor       String?
  sds                   String?
  style                 String?
  sterility             String?
  properties            String?
  construction          String?
  dilutionRatio         String?
  vendorId              String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  disapprovalMsg        String?
  height                String?
  intoWishList          Boolean?
  length                String?
  rating                String?
  video                 String?
  weight                String?
  width                 String?
  status                productStatus          @default(PENDING)
  bannerImage           String?
  reason                String?
  scent                 String?
  viscosity             String?
  fluidResistance       String?
  filtrationRate        String?
  brand                 String?
  isLicenseRequired     Boolean                @default(false)
  deliveryOptions       Json?
  isActive              Boolean                @default(true)
  shippingMethod        ShippingMethod         @default(UPS)
  flatRate              Float?                 @default(0)
  inventoryType         ProductInventoryType   @default(CONSUMABLE)
  inventoryTypeId       String?
  slug                  String                 @unique
  inventoryItems        Inventory[]
  notifications         Notification[]
  inventoryTypeRelation Inventory_type?        @relation(fields: [inventoryTypeId], references: [id])
  material              Material?              @relation(fields: [materialId], references: [id])
  vendor                Vendors                @relation(fields: [vendorId], references: [id])
  categories            ProductCategory[]
  variants              ProductVariant[]
  purchaseOrderDetails  PurchaseOrderDetail[]
  purchaseReturnDetails PurchaseReturnDetail[]
  questions             Questions[]
  reviews               Reviews[]
  transferDetails       TransferDetail[]
  promotions            Promotion[]            @relation("PromotionProducts")
  bundleItems           BundleItem[]
}

model Inventory_type {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isActive  Boolean   @default(true)
  products  Product[]
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  product    Product  @relation(fields: [productId], references: [id])

  @@id([productId, categoryId])
}

model Promotion {
  id                      String               @id @default(uuid())
  name                    String
  code                    String?              @unique
  type                    PromotionType
  minPurchaseValue        Float?
  freeShippingValue       Float?
  maxOrdersPerUser        Int?
  appliesToAllProducts    Boolean?             @default(true)
  selectedProductIds      String[]
  capMinValue             Float?
  capMaxValue             Float?
  eligibleCustomers       EligibleCustomerType
  customerTypes           CustomerType[]
  highSpendLimit          Float?
  eligibleCountries       String[]
  eligibleStates          String[]
  eligibleCities          String[]
  deliveryOptions         DeliveryOption[]
  durationType            DurationType
  startDate               DateTime?
  endDate                 DateTime?
  status                  Boolean              @default(true)
  buyQuantity             Int?
  buyProductIds           String[]
  getQuantity             Int?
  getProductIds           String[]
  spendAmount             Float?
  spendFixedDiscount      Float?
  spendPercentageDiscount Float?
  selectedCategoryIds     String[]             @default([])
  totalUsageLimit         Int?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  vendorId                String
  bundleDeals             BundleDeal[]
  orderPromotions         OrderPromotion[]
  usages                  PromotionUsage[]
  vendor                  Vendors              @relation("PromotionVendor", fields: [vendorId], references: [id])
  products                Product[]            @relation("PromotionProducts")
}

model PromotionUsage {
  id          String    @id @default(uuid())
  promotionId String
  userId      String
  orderId     String
  discountAmt Float
  usedAt      DateTime  @default(now())

  promotion   Promotion @relation(fields: [promotionId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  order       Orders    @relation(fields: [orderId], references: [id])

  @@index([promotionId])
  @@index([userId])
}

// DEPRECATED — replaced by BundleProduct system. Do not use for new features.
model BundleDeal {
  id                       String    @id @default(uuid())
  promotionId              String
  bundleQuantity           Int
  bundlePercentageDiscount Float?
  bundleFixedDiscount      Float?
  promotion                Promotion @relation(fields: [promotionId], references: [id])
}

// ─────────────────────────────────────────────
// BUNDLE DEALS SYSTEM — New independent models
// ─────────────────────────────────────────────

model BundleProduct {
  id                 String            @id @default(uuid())
  title              String
  slug               String            @unique
  description        String?
  images             String[]          @default([])
  bundlePrice        Float
  originalPrice      Float
  discountPercentage Float
  label              String?
  isActive           Boolean           @default(false)
  status             BundleStatus      @default(DRAFT)
  disapprovalMsg     String?
  vendorId           String
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // Discount settings
  discountType       String?
  discountValue      Float?
  // Applied-to settings
  appliedTo          String?
  productIds         String[]          @default([])
  categoryIds        String[]          @default([])
  minQuantity        Int?
  // Duration settings
  durationType        String?
  startDate           DateTime?
  endDate             DateTime?
  // Purchase limit settings
  maxPurchasesPerUser Int?
  // Delivery charges
  deliveryCharges     Float             @default(0)
  vendor              Vendors           @relation(fields: [vendorId], references: [id])
  approvedBy          Admin?            @relation(fields: [approvedById], references: [id])
  items               BundleItem[]
  cartItems           BundleCartItem[]
  orderItems          BundleOrderItem[]
  usages              BundleUsage[]

  @@index([vendorId])
  @@index([status])
  @@index([isActive])
}

model BundleItem {
  id              String          @id @default(uuid())
  bundleId        String
  productId       String
  variantId       String?
  quantity        Int
  priceAtCreation Float
  bundle          BundleProduct   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id])
  variant         ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([bundleId])
}

model BundleCartItem {
  cartId        String
  bundleId      String
  quantity      Int
  priceAtAdding Float
  cart          Cart          @relation(fields: [cartId], references: [id])
  bundle        BundleProduct @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@id([cartId, bundleId])
}

model BundleOrderItem {
  orderId         String
  bundleId        String
  quantity        Int
  priceAtPurchase Float
  vendorId        String
  status          OrderStatus
  productSnapshot Json          @default("{}")
  order           Orders        @relation(fields: [orderId], references: [id])
  bundle          BundleProduct @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  vendor          Vendors       @relation(fields: [vendorId], references: [id])

  @@id([orderId, bundleId])
}

model BundleUsage {
  id          String        @id @default(uuid())
  bundleId    String
  userId      String
  orderId     String
  purchasedAt DateTime      @default(now())
  bundle      BundleProduct @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id])
  order       Orders        @relation(fields: [orderId], references: [id])

  @@index([bundleId])
  @@index([userId])
  @@index([bundleId, userId])
}

model ProductVariant {
  id                  String               @id @default(uuid())
  color               String?
  size                String?
  images              String[]             @default([])
  quantity            Int                  @default(0)
  sku                 String?
  barCode             String?
  price               Float
  discount            Int?
  discountedPrice     Float?
  endingDate          DateTime?
  productId           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  AutoOrder           AutoOrder[]
  cancelOrderVariants CancelOrderVariant[]
  cartItems           CartItem[]
  orders              OrderItems[]
  product             Product              @relation(fields: [productId], references: [id])
  returnOrderVariants ReturnOrderVariant[]
  attributes          VariantAttribute[]
  wishlistItems       WishlistItem[]
  bundleItems         BundleItem[]
}

model VariantAttribute {
  id        String         @id @default(uuid())
  variantId String
  name      String
  value     String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Address {
  id            String      @id @default(uuid())
  city          String
  state         String
  country       String?
  zipCode       String
  userId        String?
  building      String?
  createdAt     DateTime    @default(now())
  extension     String?
  isDefault     Boolean?    @default(false)
  officeName    String?
  phone         String?
  streetAddress String
  updatedAt     DateTime    @updatedAt
  vendorId      String?     @unique
  user          User?       @relation(fields: [userId], references: [id])
  vendor        Vendors?    @relation(fields: [vendorId], references: [id])
  AutoOrder     AutoOrder[]
  order         Orders[]
}

model SuperAdmin {
  id            String         @id @default(uuid())
  email         String         @unique
  phone         String
  firstName     String
  lastName      String
  role          Role           @default(SUPER_ADMIN)
  password      String
  resetToken    String?
  resetTokenExp DateTime?
  profile       String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
}

model Admin {
  id               String            @id @default(uuid())
  firstName        String
  lastName         String
  email            String            @unique
  phone            String
  role             Role              @default(ADMIN)
  password         String
  resetToken       String?
  resetTokenExp    DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  address          String
  dateOfBirth      DateTime?
  status           Status            @default(ACTIVE)
  reason           String?
  profile          String?
  adminRoles       AdminRole[]
  blogPosts        BlogPost[]
  emergencyContact EmergencyContact?
  notifications    Notification[]
  vendors          Vendors[]
  approvedBundles  BundleProduct[]
}

model EmergencyContact {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  contactNo String
  relation  String
  adminId   String @unique
  admin     Admin  @relation(fields: [adminId], references: [id])
}

model AdminRole {
  id         String  @id @default(uuid())
  management String
  view       Boolean @default(false)
  edit       Boolean @default(false)
  add        Boolean @default(false)
  delete     Boolean @default(false)
  adminId    String
  admin      Admin   @relation(fields: [adminId], references: [id])
}

model Vendors {
  id                 String              @id @default(uuid())
  firstName          String
  lastName           String
  adminId            String?
  email              String              @unique
  phone              String
  isApproved         Boolean?            @default(false)
  password           String
  role               Role                @default(VENDOR)
  resetToken         String?
  resetTokenExp      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  autherizeDist      Boolean?            @default(false)
  businessType       VendorBusinessType?
  defaultUps         Boolean?            @default(false)
  delieryId          String?
  ownProductManf     Boolean?            @default(false)
  webisteName        String?
  websiteUrl         String?
  workPhone          String?
  status             vendorStatus        @default(PENDING)
  dateOfBirth        String?
  reason             String?
  returnPolicy       Boolean?            @default(false)
  profile            String?
  lastSeen           DateTime?
  link               String?
  lastStatusNotifyAt DateTime?
  address            Address?
  answer             Answers[]
  blogPosts          BlogPost[]
  chats              Chat[]              @relation("VendorChats")
  commission         Commission?
  notifications      Notification[]
  orders             OrderItems[]
  products           Product[]
  promotion          Promotion[]         @relation("PromotionVendor")
  transactions       Transaction[]
  vendorDebts        VendorDebts[]
  transfers          VendorTransfers[]
  ups                VendorUPS[]
  admin              Admin?              @relation(fields: [adminId], references: [id])
  connectAccount     connectAccount?
  bundles            BundleProduct[]
  bundleOrderItems   BundleOrderItem[]
}

model Commission {
  id                   String         @id @default(uuid())
  vendorId             String         @unique
  commissionPercentage Float          @default(5)
  payOnStatus          PayStatus      @default(DELIVERED)
  calculationMethod    CommissionType @default(WHOLE_ORDER)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  vendor               Vendors        @relation(fields: [vendorId], references: [id])
}

model VendorTransfers {
  id                             String                @id @default(uuid())
  transferId                     String?
  orderId                        String
  vendorId                       String
  saleItemPrice                  Float
  tax                            Float
  shippingCost                   Float
  total                          Float
  transactionType                TransactionType       @default(SALE)
  vendorSalePriceAfterCommission Float
  vendorTax                      Float
  vendorShipping                 Float
  vendorTotal                    Float
  platformCommission             Float
  platformTax                    Float
  platformShipping               Float
  platformStripeFee              Float
  platformTotal                  Float
  shipment                       String
  pendingAmount                  Float?
  status                         VendorTransfersStatus @default(PENDING)
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt
  order                          Orders                @relation(fields: [orderId], references: [id])
  vendor                         Vendors               @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, orderId])
}

model VendorDebts {
  id        String   @id @default(uuid())
  vendorId  String
  orderId   String
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Orders   @relation(fields: [orderId], references: [id])
  vendor    Vendors  @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, orderId], name: "vendorId_orderId_unique")
}

model VendorUPS {
  id          String   @id @default(uuid())
  accountNo   String?
  email       String?
  serviceName String?
  websiteUrl  String?
  phoneNo     String?
  vendorId    String?  @unique
  vendor      Vendors? @relation(fields: [vendorId], references: [id])
  accessToken String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

